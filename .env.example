# Required — your OpenAI API key (never commit the real one)
OPENAI_API_KEY=sk-...

# Optional — any Chat Completions model with tool calling.
# Default: gpt-5.4-mini (falls back to gpt-4.1-mini automatically if your key can't use it)
# OPENAI_MODEL=gpt-5.4-mini

# Optional — an email or URL sent to Open Library so it can identify this app.
# OPENLIBRARY_CONTACT=https://github.com/your-name/your-repo
